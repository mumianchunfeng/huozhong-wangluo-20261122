{
  "_meta": {
    "schema": "net-check/2.0-dom",
    "title": "校验器 · 域表（规则 / 依据 / 如何补偿）",
    "note": "从「真事-校验器」拆出的域级判据。同一件征收事，法律域引区片综合地价与文号，政务域看公告期与听证登记，金融域看专款拨付与金额。三套各写一份，互不借用。"
  },
  "by_domain": {
    "LW": {
      "rule": {
        "must_all": [["112.5"], ["135"], ["永久基本农田"]],
        "must_none": ["市场评估价", "协商确定", "协商定价"],
        "fail_hint": "未按法定区片综合地价并区分永久基本农田，或改用市场协商定价"
      },
      "basis": {
        "must_all": [["鲁政字〔2023〕144号", "鲁政字[2023]144号", "鲁政字（2023）144号"]],
        "must_none": ["自身即为补偿标准依据", "公告自身作为依据"],
        "fail_hint": "依据文号错：只引了地上附着物标准，或拿公告自身当补偿标准依据（循环依据）"
      },
      "comp": {
        "must_all": [["货币"], ["养老", "社会保障", "社保"]],
        "must_none": ["不再安排社会保障", "直接向农户", "不再经村集体"],
        "fail_hint": "补偿构成错：漏社保安置、漏经村集体分配"
      }
    },
    "GV": {
      "rule": {
        "must_all": [["公告期", "听证"]],
        "must_none": ["即日生效"],
        "fail_hint": "漏公告期或听证，程序不成立"
      },
      "basis": {
        "must_all": [["张征补公告〔2025〕6号"]],
        "must_none": ["口述"],
        "fail_hint": "未引公告文号"
      },
      "comp": {
        "must_all": [["补偿登记"]],
        "must_none": [],
        "fail_hint": "漏补偿登记"
      }
    },
    "FI": {
      "rule": {
        "must_all": [["专户", "不得挪用"]],
        "must_none": [],
        "fail_hint": "未按专款专用"
      },
      "basis": {
        "must_all": [["院上村村民委员会账户"]],
        "must_none": [],
        "fail_hint": "未落到村委会账户"
      },
      "comp": {
        "must_all": [],
        "must_none": [],
        "fail_hint": "金额与算式不符时由跨表判据判；本域只管付款通道"
      }
    }
  }
}
