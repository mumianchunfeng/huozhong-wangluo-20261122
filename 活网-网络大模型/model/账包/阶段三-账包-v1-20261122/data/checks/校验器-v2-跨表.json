{
  "_meta": {
    "schema": "net-check/2.0-join",
    "title": "校验器 · 跨表算式（两表各取一边，算出一个数）",
    "note": "这一层不属于任何单格：补偿额＝受损面积（关系表·谁受损）× 单价（域表·规则）。历史驳回里那 5 条「金额不在区间」，只有这一层判得出来。"
  },
  "joins": [
    {
      "code": "comp_amount",
      "name": "土地补偿费与安置补助费",
      "inputs": {
        "S": {
          "field": "harm",
          "regex": "(\\d+(?:\\.\\d+)?)公顷",
          "note": "受损农用地合计"
        },
        "S_perm": {
          "field": "harm",
          "regex": "永久基本农田(\\d+(?:\\.\\d+)?)公顷",
          "note": "其中永久基本农田"
        },
        "P": {
          "field": "rule",
          "regex": "(\\d+(?:\\.\\d+)?)万元/公顷",
          "note": "一般农用地单价"
        },
        "P_perm": {
          "field": "rule",
          "regex": "永久基本农田.{0,8}?(\\d+(?:\\.\\d+)?)万元",
          "note": "永久基本农田单价"
        }
      },
      "expr": "(S - S_perm) * P + S_perm * P_perm",
      "target": {
        "field": "comp",
        "regex": "(\\d+(?:\\.\\d+)?)\\s*万元"
      },
      "tol": 1.0,
      "unit": "万元",
      "fail_hint": "金额与算式不符：把永久基本农田与一般农用地拉平，或全按高档计",
      "defaults": {
        "S_perm": 0,
        "P_perm": {
          "from": "P"
        }
      },
      "_defaults_note": "缺永久基本农田的件：S_perm 取 0、P_perm 随 P。缺省不是猜，是算式在该情形下的退化形式；公告未涉永基时本就无该项。"
    }
  ]
}